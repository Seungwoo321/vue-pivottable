{
  "name": "vue-pivottable",
  "version": "0.4.69",
  "main": "dist/vue-pivottable.mjs",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "exports": {
    ".": {
      "import": "./dist/vue-pivottable.mjs",
      "require": "./dist/vue-pivottable.umd.js"
    },
    "./dist/": "./dist/",
    "./dist/vue-pivottable.css": "./dist/vue-pivottable.css"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Seungwoo321/vue-pivottable.git"
  },
  "keywords": [
    "vue",
    "pivot",
    "pivottable",
    "vue-pivottable"
  ],
  "homepage": "https://seungwoo321.github.io/vue-pivottable/",
  "author": "Seungwoo, Lee <seungwoo321@gmail.com> (https://github.com/seungwoo321)",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist packages/*/dist",
    "dev": "vite",
    "build": "vite build",
    "build:all": "pnpm run build && pnpm run build:packages",
    "build:packages": "pnpm --recursive --filter \"./packages/*\" run build",
    "serve": "vite preview",
    "lint": "eslint --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:dev": "pnpm --filter docs run docs:dev",
    "docs:build": "pnpm --filter docs run docs:build",
    "release": "release-it"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "vue": "^2.6.10"
  },
  "dependencies": {
    "vuedraggable": "^2.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@release-it/conventional-changelog": "^10.0.5",
    "@seungwoo321/eslint-plugin-standard-js": "^1.0.1",
    "@storybook/addon-essentials": "^7.6.0",
    "@storybook/addon-interactions": "^7.6.0",
    "@storybook/addon-links": "^7.6.0",
    "@storybook/blocks": "^7.6.0",
    "@storybook/testing-library": "^0.2.0",
    "@storybook/vue": "^7.6.0",
    "@storybook/vue-vite": "^7.6.0",
    "@vitejs/plugin-vue2": "^2.0.0",
    "@vue-pivottable/multi-value-renderer": "0.1.0",
    "@vue-pivottable/subtotal-renderer": "0.1.0",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "jsdom": "^24.0.0",
    "release-it": "^19.2.4",
    "rimraf": "^6.0.1",
    "storybook": "^7.6.0",
    "typescript": "^5.9.3",
    "vite": "^3.1.8",
    "vite-plugin-static-copy": "^0.11.1",
    "vitest": "^1.6.0",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  }
}
